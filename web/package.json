{
  "name": "ocms-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test:ui": "playwright test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write .",
    "prepare": "cd .. && husky web/.husky",
    "check:staged": "lint-staged --cwd .",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:routing": "playwright test --config playwright.routing.config.ts",
    "test:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cytoscape": "3.34.4",
    "cytoscape-cola": "2.5.1",
    "d3-cloud": "1.2.9",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-cloud": "1.2.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "msw": "3.0.3",
    "msw-storybook-addon": "3.0.3",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css,html}": "biome check --write --error-on-warnings --no-errors-on-unmatched"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
