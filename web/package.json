{
  "name": "ocms-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test:ui": "playwright test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write .",
    "prepare": "cd .. && husky web/.husky",
    "check:staged": "lint-staged --cwd ."
  },
  "dependencies": {
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css,html}": "biome check --write --error-on-warnings --no-errors-on-unmatched"
  }
}
