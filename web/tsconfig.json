{
  "compilerOptions": {
    "target": "ES2022",
    "types": ["vite/client"],
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    ".storybook/*.ts",
    ".storybook/*.tsx",
    "vitest.storybook.config.ts"
  ]
}
